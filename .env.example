# Copy to .env and fill in the values. Never commit .env.

# --- App ---
# Used by the tRPC client during server rendering. Must match the port `npm run dev` uses.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL, e.g. Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/craafter?sslmode=require"

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=""
# Optional model overrides (defaults: gemini-3.5-flash / gemini-3.5-flash-lite)
# GEMINI_CODE_MODEL=""
# GEMINI_SUMMARY_MODEL=""
# Rounds the agent gets to fix errors the app check finds (default 3). Each round
# costs a few requests; lower it on a free key, 0 only reports the errors.
# CODE_AGENT_FIX_ATTEMPTS="3"
# Optional stronger models, used only for fixing errors the app check finds and
# for reviewing the acceptance checks (defaults: the code / summary model)
# GEMINI_FIX_MODEL="gemini-3.5-flash"
# GEMINI_REVIEW_MODEL="gemini-3.5-flash"

# --- Groq (https://console.groq.com/keys), optional ---
# Used only when Gemini refuses a call (quota or rate limit): the run switches to
# Groq and carries on, and later runs start there until the cooldown expires.
# GROQ_API_KEY=""
# GROQ_CODE_MODEL="openai/gpt-oss-20b"
# GROQ_SUMMARY_MODEL="openai/gpt-oss-20b"
# What the fallback may take over. Groq's free tier allows 8,000 tokens/minute and
# one code-agent request is bigger than that, so by default only the small calls
# (title, reply, checks review) fall back. On a paid Groq tier use:
# GROQ_ROLES="code,fix,summary,review"
# How long to stay on the fallback after Gemini ran out (default 120)
# PROVIDER_COOLDOWN_MINUTES="120"

# --- E2B sandboxes (https://e2b.dev/dashboard) ---
E2B_API_KEY=""

# --- Clerk auth & billing (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# --- Inngest ---
# Local: keep INNGEST_DEV=1 and run `npm run dev:inngest`. Jobs then run on your machine.
# Without it, events go to Inngest Cloud and run on your deployed app instead.
INNGEST_DEV=1
# Production only (set these in Vercel, not locally):
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
